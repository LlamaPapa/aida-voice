# OpenAI API key for Whisper transcription (~$0.006/minute)
OPENAI_API_KEY=sk-...

# Anthropic API key for Claude structuring
ANTHROPIC_API_KEY=sk-ant-...

# Optional: default structuring mode (message, notes, email, code, raw)
VOICE_MODE=message

# Optional: auto-paste after copy (true/false)
VOICE_AUTO_PASTE=true
